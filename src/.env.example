POSTGRES_PASSWORD=your_password
POSTGRES_USER=user_name
POSTGRES_DB=postgres
POSTGRES_AUTH_DB=auth_db
POSTGRES_ATS_DB=ats_db


JWT_SECRET=your_base64_or_32_char_secret_key_here
JWT_EXPIRATION_MS=7200000

# database (Prisma). Host is the compose service name; user/password/db must match the values above.
DATABASE_URL=postgresql://user_name:your_password@postgres_db:5432/ats_db
