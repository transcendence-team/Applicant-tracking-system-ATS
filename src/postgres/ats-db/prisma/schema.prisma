// ATS Service (Node.js) database schema.
//
// OWNERSHIP RULE: this schema owns ONLY the `ats_db` database.
// Users / roles / permissions live in `auth_db` and are owned by the Spring
// Boot auth-service. Postgres cannot enforce foreign keys across databases, so
// every `userId`-style column below is a plain UUID (the JWT `sub` claim) with
// NO relation to a users table. Never JOIN against auth_db from this service.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum Recommendation {
  STRONG_MATCH
  MATCH
  PARTIAL_MATCH
  NO_MATCH
}

enum SkillMatchType {
  EXACT
  RELATED
  MISSING
}

enum NotificationType {
  APPLICATION_RECEIVED
  STATUS_CHANGED
  NEW_APPLICANT
  AI_ANALYSIS_READY
  JOB_ASSIGNED
}

enum GdprRequestType {
  EXPORT
  DELETE
}

enum GdprRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

// ───────────────────────────── Profiles ─────────────────────────────

model CandidateProfile {
  id           Int      @id @default(autoincrement())
  userId       String   @unique @map("user_id") @db.Uuid // auth_db.users.id
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  phone        String?
  location     String?
  linkedinUrl  String?  @map("linkedin_url")
  githubUrl    String?  @map("github_url")
  portfolioUrl String?  @map("portfolio_url")
  bio          String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  resumes      Resume[]
  applications Application[]

  @@map("candidate_profiles")
}

model EmployeeProfile {
  id         Int      @id @default(autoincrement())
  userId     String   @unique @map("user_id") @db.Uuid // auth_db.users.id
  firstName  String?  @map("first_name")
  lastName   String?  @map("last_name")
  phone      String?
  department String?
  jobTitle   String?  @map("job_title")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("employee_profiles")
}

// ───────────────────────────── Jobs ─────────────────────────────

model Job {
  id             Int             @id @default(autoincrement())
  createdBy      String          @map("created_by") @db.Uuid // auth_db.users.id
  title          String
  description    String?         @db.Text
  location       String?
  employmentType EmploymentType? @map("employment_type")
  status         JobStatus       @default(DRAFT)
  salaryMin      Int?            @map("salary_min")
  salaryMax      Int?            @map("salary_max")
  publishedAt    DateTime?       @map("published_at")
  deadline       DateTime?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  recruiters   JobRecruiter[]
  skills       JobSkill[]
  applications Application[]

  @@index([status])
  @@index([createdBy])
  @@map("jobs")
}

model JobRecruiter {
  jobId      Int      @map("job_id")
  userId     String   @map("user_id") @db.Uuid // auth_db.users.id (HR)
  assignedBy String?  @map("assigned_by") @db.Uuid // auth_db.users.id
  assignedAt DateTime @default(now()) @map("assigned_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, userId])
  @@index([userId])
  @@map("job_recruiters")
}

model Skill {
  id   Int    @id @default(autoincrement())
  name String @unique

  jobSkills JobSkill[]
  aiMatches AiSkillMatch[]

  @@map("skills")
}

// Join table Job <-> Skill
model JobSkill {
  jobId      Int     @map("job_id")
  skillId    Int     @map("skill_id")
  isRequired Boolean @default(true) @map("is_required")
  importance Int?

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

// ───────────────────────────── Applications ─────────────────────────────

model ApplicationStatus {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  position   Int     @default(0)
  isTerminal Boolean @default(false) @map("is_terminal")

  applications Application[]
  historyFrom  ApplicationStatusHistory[] @relation("HistoryFromStatus")
  historyTo    ApplicationStatusHistory[] @relation("HistoryToStatus")

  @@map("application_statuses")
}

model Resume {
  id               Int       @id @default(autoincrement())
  candidateId      Int       @map("candidate_id")
  originalFilename String    @map("original_filename")
  storagePath      String    @map("storage_path")
  mimeType         String    @map("mime_type")
  fileSize         Int       @map("file_size")
  fileHash         String?   @map("file_hash")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  deletedAt        DateTime? @map("deleted_at") // soft delete

  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications Application[]
  extraction   ResumeExtraction?
  aiAnalyses   AiAnalysis[]

  @@index([candidateId])
  @@index([fileHash])
  @@map("resumes")
}

model Application {
  id          Int      @id @default(autoincrement())
  jobId       Int      @map("job_id")
  candidateId Int      @map("candidate_id")
  resumeId    Int?     @map("resume_id")
  statusId    Int      @map("status_id")
  coverLetter String?  @map("cover_letter") @db.Text
  version     Int      @default(1) // optimistic locking for Kanban drag & drop
  appliedAt   DateTime @default(now()) @map("applied_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  resume    Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status    ApplicationStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)

  history       ApplicationStatusHistory[]
  aiAnalyses    AiAnalysis[]
  notifications Notification[]

  @@unique([jobId, candidateId])
  @@index([statusId])
  @@index([candidateId])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            Int      @id @default(autoincrement())
  applicationId Int      @map("application_id")
  fromStatusId  Int?     @map("from_status_id")
  toStatusId    Int      @map("to_status_id")
  changedBy     String?  @map("changed_by") @db.Uuid // auth_db.users.id
  comment       String?  @db.Text
  changedAt     DateTime @default(now()) @map("changed_at")

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus  ApplicationStatus? @relation("HistoryFromStatus", fields: [fromStatusId], references: [id], onDelete: Restrict)
  toStatus    ApplicationStatus  @relation("HistoryToStatus", fields: [toStatusId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@map("application_status_history")
}

// ───────────────────────────── AI Worker tables ─────────────────────────────

model ResumeExtraction {
  id            Int              @id @default(autoincrement())
  resumeId      Int              @unique @map("resume_id")
  rawText       String?          @map("raw_text") @db.Text
  parserVersion String?          @map("parser_version")
  status        ExtractionStatus @default(PENDING)
  extractedAt   DateTime?        @map("extracted_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_extractions")
}

model AiAnalysis {
  id             Int             @id @default(autoincrement())
  applicationId  Int             @map("application_id")
  resumeId       Int?            @map("resume_id")
  modelName      String?         @map("model_name")
  promptVersion  String?         @map("prompt_version")
  summary        String?         @db.Text
  matchScore     Decimal?        @map("match_score") @db.Decimal(5, 2) // 0.00 - 100.00
  recommendation Recommendation?
  analysisStatus AnalysisStatus  @default(PENDING) @map("analysis_status")
  createdAt      DateTime        @default(now()) @map("created_at")
  completedAt    DateTime?       @map("completed_at")

  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resume      Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  skillMatches AiSkillMatch[]

  @@index([applicationId])
  @@map("ai_analyses")
}

model AiSkillMatch {
  id           Int            @id @default(autoincrement())
  aiAnalysisId Int            @map("ai_analysis_id")
  skillId      Int            @map("skill_id")
  matchType    SkillMatchType @map("match_type")
  confidence   Decimal?       @db.Decimal(4, 3) // 0.000 - 1.000

  aiAnalysis AiAnalysis @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([aiAnalysisId])
  @@index([skillId])
  @@map("ai_skill_matches")
}

// ───────────────────────────── Cross-cutting ─────────────────────────────

model Notification {
  id            Int              @id @default(autoincrement())
  userId        String           @map("user_id") @db.Uuid // recipient, auth_db.users.id
  applicationId Int?             @map("application_id")
  type          NotificationType
  title         String
  message       String?          @db.Text
  isRead        Boolean          @default(false) @map("is_read")
  createdAt     DateTime         @default(now()) @map("created_at")
  readAt        DateTime?        @map("read_at")

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model ActivityEvent {
  id         Int      @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  eventType  String   @map("event_type")
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([eventType])
  @@map("activity_events")
}

model GdprRequest {
  id          Int               @id @default(autoincrement())
  userId      String            @map("user_id") @db.Uuid
  requestType GdprRequestType   @map("request_type")
  status      GdprRequestStatus @default(PENDING)
  requestedAt DateTime          @default(now()) @map("requested_at")
  completedAt DateTime?         @map("completed_at")

  @@index([userId])
  @@map("gdpr_requests")
}
