# ---------------------------------
# ATS Core Database (Node.js)
# ---------------------------------
DB_NAME=ats_core_db
DB_USER=ats_admin
DB_PASS=ats_password123

# ats-service (Prisma). Host is the ats_db compose service;
# user/password/db must match DB_USER / DB_PASS / DB_NAME above.
DATABASE_URL=postgresql://ats_admin:ats_password123@ats_db:5432/ats_core_db

# ---------------------------------
# Auth API Database (Spring Boot)
# ---------------------------------
AUTH_DB_NAME=auth_service_db
AUTH_DB_USER=auth_admin
AUTH_DB_PASS=auth_password123

# Spring Boot datasource aliases
POSTGRES_AUTH_DB=auth_service_db
POSTGRES_USER=auth_admin
POSTGRES_PASSWORD=auth_password123

JWT_SECRET=your_base64_or_32_char_secret_key_here
JWT_EXPIRATION_MS=7200000