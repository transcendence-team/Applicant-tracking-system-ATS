# ---------------------------------
# Asymmetric RSA JWT Keys (RS256)
# - JWT_PRIVATE_KEY: Base64-encoded PKCS#8 PEM private key (ONLY passed to auth-api)
# - JWT_PUBLIC_KEY:  Base64-encoded X.509 PEM public key  (passed to auth-api & ats-api)
# Generate new pair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | tee private.pem | base64 -w 0
#   openssl rsa -in private.pem -pubout | base64 -w 0
# ---------------------------------
JWT_PRIVATE_
JWT_PUBLIC_
JWT_EXPIRATION_MS=7200000

# ---------------------------------
# ATS Core Service & Database (Node.js)
# ---------------------------------
DB_NAME=ats_core_db
DB_USER=ats_admin
DB_PASS=ats_password123

# ats-service (Prisma). Host is the ats_db compose service;
# user/password/db must match DB_USER / DB_PASS / DB_NAME above.
DATABASE_URL=postgresql://ats_admin:ats_password123@ats_db:5432/ats_core_db

# ---------------------------------
# Auth API & Database (Spring Boot)
# ---------------------------------
AUTH_DB_NAME=auth_service_db
AUTH_DB_USER=auth_admin
AUTH_DB_PASS=auth_password123

# Initial Admin Account (seeded on startup if not already in DB)
ADMIN_EMAIL=admin@ats.com
ADMIN_PASSWORD=adminPassword123

# ---------------------------------
# Frontend (Next.js)
# ---------------------------------
AUTH_API_URL=http://auth-api:8080